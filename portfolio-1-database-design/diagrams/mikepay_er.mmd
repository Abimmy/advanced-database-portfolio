erDiagram
    accounts ||--o{ audit_log : "account"
    accounts ||--o{ beneficiaries : "beneficiary"
    accounts ||--o{ transactions : "account"
    accounts ||--o{ transfers : "destination"
    accounts ||--o{ transfers : "source"
    customers ||--o{ accounts : "customer"
    customers ||--o{ beneficiaries : "customer"
    transfers |o--o{ transactions : "transfer"

    accounts {
        int account_id PK
        int customer_id FK
        char account_number UK
        enum account_type
        char currency
        decimal balance
        enum status
        datetime opened_at
    }
    audit_log {
        bigint audit_id PK
        int account_id FK
        enum action
        decimal old_balance
        decimal new_balance
        varchar changed_by
        datetime changed_at
    }
    beneficiaries {
        int beneficiary_id PK
        int customer_id FK
        int beneficiary_account_id FK
        varchar nickname
        datetime created_at
    }
    customers {
        int customer_id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone UK
        enum status
        datetime created_at
    }
    transactions {
        bigint transaction_id PK
        int account_id FK
        bigint transfer_id FK
        enum transaction_type
        decimal amount
        decimal balance_after
        varchar description
        datetime created_at
    }
    transfers {
        bigint transfer_id PK
        varchar reference UK
        int source_account_id FK
        int destination_account_id FK
        decimal amount
        enum status
        varchar failure_reason
        datetime created_at
        datetime completed_at
    }
